# Base URL of the Black Diamond Tours API (must include /api/v1).
# Production:        https://blackdiamondtours.com.np/api/v1
# Android emulator:  http://10.0.2.2:8000/api/v1   (website running locally with: php -S 0.0.0.0:8000 -t public_html)
EXPO_PUBLIC_API_BASE_URL=https://blackdiamondtours.com.np/api/v1

# Google Maps SDK key for Android is configured in app.json / EAS secrets, not here. See docs/google-maps.md.
